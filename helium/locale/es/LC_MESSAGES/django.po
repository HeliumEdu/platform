msgstr "Este es tu último aviso."

#: auth/templates/email/dormant_warning.html
#: auth/templates/email/dormant_warning.txt
#, python-format
msgid "Your Helium account will be permanently deleted tomorrow due to %(years)s+ years of inactivity."
msgstr "Tu cuenta de Helium se eliminará de forma permanente mañana por más de %(years)s años de inactividad."

#: auth/templates/email/dormant_warning.html
#, python-format
msgid "Your Helium account is scheduled for deletion in <strong>%(days)s day</strong> due to %(years)s+ years of inactivity."
msgid_plural "Your Helium account is scheduled for deletion in <strong>%(days)s days</strong> due to %(years)s+ years of inactivity."
msgstr[0] "Tu cuenta de Helium se eliminará en <strong>%(days)s día</strong> por más de %(years)s años de inactividad."
msgstr[1] "Tu cuenta de Helium se eliminará en <strong>%(days)s días</strong> por más de %(years)s años de inactividad."

#: auth/templates/email/dormant_warning.html
#: auth/templates/email/dormant_warning.txt
msgid "When your account is deleted, all data stored in Helium will also be deleted and cannot be recovered, including your classes, assignments, grades, notes, and attachments."
msgstr "Cuando se elimine tu cuenta, todos los datos almacenados en Helium también se eliminarán y no se podrán recuperar, incluidas tus clases, tareas, calificaciones, notas y archivos adjuntos."

#: auth/templates/email/dormant_warning.html
#, python-format
msgid "<strong>To keep your free account,</strong> simply <a href=\"%(login_url)s\" target=\"_blank\">log in</a>. That's all it takes."
msgstr "<strong>Para conservar tu cuenta gratuita,</strong> solo tienes que <a href=\"%(login_url)s\" target=\"_blank\">iniciar sesión</a>. Eso es todo."

#: auth/templates/email/dormant_warning.html
#, python-format
msgid "If you'd like to delete your account, but also want a copy of your data, see our guide on <a href=\"%(export_url)s\" target=\"_blank\">exporting your data</a>, and our guide on <a href=\"%(delete_account_url)s\" target=\"_blank\">deleting your account manually</a>."
msgstr "Si quieres eliminar tu cuenta pero también quieres una copia de tus datos, consulta nuestra guía para <a href=\"%(export_url)s\" target=\"_blank\">exportar tus datos</a> y nuestra guía para <a href=\"%(delete_account_url)s\" target=\"_blank\">eliminar tu cuenta manualmente</a>."

#: auth/templates/email/dormant_warning.html
#, python-format
msgid "Questions? <a href=\"%(support_url)s\" target=\"_blank\">Contact support</a>."
msgstr "¿Tienes preguntas? <a href=\"%(support_url)s\" target=\"_blank\">Ponte en contacto con el equipo de soporte</a>."

#: auth/templates/email/dormant_warning.txt
#, python-format
