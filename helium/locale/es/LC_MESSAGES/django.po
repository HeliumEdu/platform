#: planner/views/base.py
msgid "Both 'from' and 'to' must be provided together."
msgstr "'from' y 'to' deben indicarse juntos."

#: planner/views/base.py
msgid "Change `recurrence_rule` or `exception_dates` with `scope=all`."
msgstr "Para cambiar `recurrence_rule` o `exception_dates`, usa `scope=all`."

