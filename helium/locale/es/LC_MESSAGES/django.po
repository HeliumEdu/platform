#: common/utils/validators.py
msgid "Enter a valid fraction of the format 'x/y'."
msgstr "Ingresa una fracción válida con el formato 'x/y'."

#: common/utils/validators.py
msgid "The fraction must contain valid integers."
msgstr "La fracción debe contener números enteros válidos."

#: common/utils/validators.py
#, python-format
msgid "Values must be less than or equal to %(max)s."
msgstr "Los valores deben ser menores o iguales a %(max)s."

#: common/utils/validators.py
msgid "The denominator must be greater than zero."
msgstr "El denominador debe ser mayor que cero."

#: common/utils/validators.py
msgid "The grade does not appear to be valid."
msgstr "La calificación no parece ser válida."

#: common/utils/validators.py
msgid "The value must be a valid hex color code."
msgstr "El valor debe ser un código de color hexadecimal válido."

#: common/utils/validators.py
#, python-format
msgid "A grade scale must have between %(min)s and %(max)s bands."
msgstr "Una escala de calificaciones debe tener entre %(min)s y %(max)s rangos."

#: common/utils/validators.py
msgid "The first band's 'min_grade' must be 0."
msgstr "El 'min_grade' del primer rango debe ser 0."

#: common/utils/validators.py
msgid "Each band's 'min_grade' must be greater than the band before it."
msgstr "El 'min_grade' de cada rango debe ser mayor que el del rango anterior."

#: common/utils/validators.py
msgid "The bands' 'grade_point' values must only rise or only fall."
msgstr "Los valores de 'grade_point' de los rangos solo pueden subir o solo bajar."

#: common/utils/validators.py
msgid "Quill content must be an object."
msgstr "El contenido de Quill debe ser un objeto."

#: common/utils/validators.py
msgid "Quill content must have an `ops` list."
msgstr "El contenido de Quill debe tener una lista `ops`."

#: common/utils/validators.py
msgid "Quill content `ops` must each be an `insert` (text or an embed object), with optional `attributes`."
msgstr "Cada elemento de `ops` del contenido de Quill debe ser un `insert` (texto o un objeto incrustado), con `attributes` opcionales."

#: common/utils/validators.py
